# Copy to .env and fill in values before running the backend.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dma:dma_local_dev_only@localhost:5432/digital_memory

# --- Storage ---
UPLOAD_DIR=./uploads

# --- Embeddings ---
# Option A: free local embeddings (no API key, ~130 MB download on first run)
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384

# Option B: OpenAI (paid, best quality)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_DIM=1536
