# Copy to .env and fill in values before running the backend.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://dma:dma_local_dev_only@localhost:5432/digital_memory

# --- Storage ---
UPLOAD_DIR=./uploads

# --- Embeddings ---
# Switch to "openai" + provide OPENAI_API_KEY for real semantic search.
# "deterministic" works for local dev but search quality is hash-based, not semantic.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Leave these at defaults unless you switch models.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
